[Unit]
Description=WhatsApp do bot de ofertas (Baileys)
After=network-online.target
Wants=network-online.target

[Service]
User=opc
WorkingDirectory=/home/opc/bot-ofertas/whatsapp
Environment=BOT_CONFIG=/home/opc/bot-config/config.txt
Environment=TZ=America/Sao_Paulo
Environment=NODE_OPTIONS=--max-old-space-size=200
ExecStart=/usr/bin/node servidor.js
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
