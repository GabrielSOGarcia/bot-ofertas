[Unit]
Description=Bot de ofertas (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=opc
WorkingDirectory=/home/opc/bot-ofertas
Environment=BOT_CONFIG=/home/opc/bot-config/config.txt
Environment=BOT_OBSIDIAN=
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=America/Sao_Paulo
ExecStart=/usr/bin/python3 -u postar_shopee.py %i
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
