[Unit]
Description=Painel dos bots pelo Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=opc
WorkingDirectory=/home/opc/bot-ofertas
Environment=BOT_CONFIG=/home/opc/bot-config/config.txt
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=America/Sao_Paulo
ExecStart=/usr/bin/python3 -u painel.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
